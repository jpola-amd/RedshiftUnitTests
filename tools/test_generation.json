                "feature/xsi_unit_tests/Scenes/UnitTests/Bugs/Bug2559_MultipleVtxFormatsBadGeo.rs",
                "feature/xsi_unit_tests/Scenes/UnitTests/Bugs/Bug2876_BadMemoryLayoutForBlendedSSSAndBump.rs",
                "feature/xsi_unit_tests/Scenes/UnitTests/Bugs/Bug3073_3074_PortalAndDomeGlitches.rs",
                "feature/c4d_feature_scenes/osl/closure.rs",
                "feature/xsi_unit_tests/Scenes/UnitTests/ICE/ice-uv+vtxcol+wm.rs",
                "feature/c4d_feature_scenes/bugs/HelmetCItyTex/helmetCity-lightc4d_0003.rs",
