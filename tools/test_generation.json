{
    "groups": {
        "feature": {
            "description": "Small single-feature scenes (correctness). Each sub-folder is a collection split into categories.",
            "layout": "categories"
        },
        "production": {
            "description": "Large production scenes (performance and correctness). Each sub-folder is one scene.",
            "layout": "scenes",
            "name_prefix": "prod"
        }
    },
    "collection_name_prefix": {
        "feature/c4d_feature_scenes": "c4d",
        "feature/xsi_unit_tests": "xsi",
        "feature/maya_test_suite": "maya",
        "feature/hip_emission": "emission",
        "feature/lighting_basics": "lighting"
    },
    "category_skip_dirs": ["scenes", "Scenes", "UnitTests"],
    "exclude": {
        "feature/xsi_unit_tests/Render_Archives/light.rs": "proxy loaded by Bug4850_ProxyLightInstancing",
        "feature/xsi_unit_tests/Render_Archives/sphere_light.rs": "proxy loaded by Bug3668_ProxyLightDuplicates",
        "production/cinebench_v5/Blanket.rs": "proxy loaded by 'benchmark v5.rs'"
    },
    "overrides": {},
    "suites": {
        "bugs_res": {
